{
  "name": "subnet-splitter",
  "version": "2.0.0",
  "description": "CIDR subnet calculator and Kubernetes (EKS, GKE, AKS) network planning API",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicholashoule/subnet-splitter.git"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/index.cjs",
    "smoke": "tsx scripts/smoke-test.ts",
    "check": "tsc",
    "test": "vitest",
    "test:emoji": "vitest run tests/unit/emoji-detection.test.ts",
    "emoji:check": "tsx scripts/fix-emoji.ts",
    "emoji:fix": "tsx scripts/fix-emoji.ts --fix",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^5.0.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
